{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Symplax",
  "description": "Deploy apps, databases and servers on your own VPS, with a Vercel-like experience. Guides, CLI and API reference.",
  "colors": {
    "primary": "#10B77F",
    "light": "#12D393",
    "dark": "#0E9F6E"
  },
  "background": {
    "color": {
      "dark": "#0B0D0C"
    }
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://symplax.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Servers",
            "pages": [
              "servers/connect",
              "servers/buy-a-server",
              "servers/monitoring",
              "servers/console"
            ]
          },
          {
            "group": "Apps",
            "pages": [
              "apps/deploy-from-github",
              "apps/docker-images",
              "apps/monorepos",
              "apps/environment-variables",
              "apps/domains",
              "apps/rollbacks",
              "apps/release-commands",
              "apps/cron-jobs",
              "apps/uptime-monitoring",
              "apps/one-click-apps"
            ]
          },
          {
            "group": "Databases",
            "pages": [
              "databases/overview",
              "databases/console",
              "databases/backups",
              "databases/public-access"
            ]
          },
          {
            "group": "Move to Symplax",
            "pages": [
              "import/railway",
              "import/digitalocean",
              "import/vercel"
            ]
          },
          {
            "group": "Teams and security",
            "pages": [
              "teams/roles",
              "security/ssh-keys",
              "security/firewall"
            ]
          },
          {
            "group": "Billing",
            "pages": [
              "billing/plans",
              "billing/wallet"
            ]
          }
        ]
      },
      {
        "tab": "CLI and API",
        "groups": [
          {
            "group": "CLI",
            "pages": [
              "cli/overview",
              "cli/mcp",
              "cli/ci"
            ]
          },
          {
            "group": "API",
            "pages": [
              "api/keys",
              "api/endpoints",
              "api/errors"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://symplax.com/dashboard",
          "icon": "gauge"
        },
        {
          "anchor": "Changelog",
          "href": "https://symplax.com/changelog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@symplax.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://symplax.com/dashboard"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/symplaxhq",
      "website": "https://symplax.com"
    }
  }
}
